# npm run dev explicitly uses development and binds to loopback.
# For a hosted pilot set NODE_ENV=production and use npm start.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Set to the public HTTPS origin for production (no path, query or fragment).
PUBLIC_URL=http://localhost:3000
# Same origin, root app URL configured in MAX's bot settings.
MINI_APP_URL=
# Уже выданный команде токен хакатона: вставьте только в локальный .env.
# Здесь оставьте пусто. Не создавайте нового бота и не выводите токен в логах.
MAX_BOT_TOKEN=
# Username выданного бота без @; при необходимости уточните у организаторов.
MAX_BOT_USERNAME=
MAX_ADMIN_IDS=
# Generate each independently with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
USER_HASH_SECRET=
MAX_WEBHOOK_SECRET=
# Example production value: https://YOUR-DOMAIN/webhook/max
MAX_WEBHOOK_URL=
# Optional PEM bundle from an official trusted CA source, never disable TLS checks.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/trusted-ca.pem
# Directory must be persistent on the host; development and production use separate files.
DATA_DIR=./data
# Default: config/buildings.example.json (synthetic; production refuses it).
BUILDINGS_FILE=./config/buildings.example.json
